# Application URL used by NextAuth (required for local development)
NEXTAUTH_URL=http://localhost:3000

# Random secret for signing sessions (required)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret

# MongoDB connection (required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=assettags

# Admin users (optional, comma-separated emails)
# Only these users can create / update / delete data. Everyone else is read-only;
# guests (not signed in) additionally see "***" instead of prices/values.
ADMIN_USERS=admin.user@jalint.com.sa
